# Gemini API key (either name works, GEMINI_API_KEY takes precedence)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# GEMINI_API_KEY=your_gemini_api_key

# Anthropic Claude API key (optional: when set, chat goes to Claude first)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Shared secret with focusly-workflows (same value there). When set, only
# requests with the X-Internal-Token header reach the AI endpoints.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FOCUSLY_AI_INTERNAL_TOKEN=

# Token spend (optional, these are the defaults)
# AI_MAX_OUTPUT_TOKENS=16384
# AI_THINKING_BUDGET_FLASH=1024
# AI_THINKING_BUDGET_PRO=2048
# AI_THINKING_BUDGET_STRUCTURED=512
# AI_REQUEST_TIMEOUT_SECONDS=60

# Port the service listens on (also used by docker-compose for the port mapping)
PORT=8001
