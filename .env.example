# Gemini API key (either name works, GOOGLE_GENERATIVE_AI_API_KEY takes precedence)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# GEMINI_API_KEY=your_gemini_api_key

# Anthropic Claude API key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Port the service listens on (also used by docker-compose for the port mapping)
PORT=8001
